# Copy to .env.local for development.
# Postgres connection string (docker compose up -d db starts a local one on port 55433).
DATABASE_URL=postgres://ikimina:ikimina@127.0.0.1:55433/ikimina
# Secret used to sign session cookies. Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
# Public URL of the app, used for invitation links when running behind a proxy.
# AUTH_URL=https://elayo.example.com
# Optional: when set, /setup asks for this code before creating the first administrator.
# SETUP_TOKEN=
# Optional: show /demo test accounts in a production build (never on a real deployment).
# ENABLE_DEMO=true

# XendlyPay app key and matching webhook signing secret. Keep these server-side.
XENDLY_API_KEY=
XENDLY_WEBHOOK_SECRET=
# Explicitly set live only when the provider app is live and the business is verified.
# Test collections move REAL money but are excluded from live savings and cashbook totals.
XENDLY_MODE=test
# Quoted provider rate in basis points: 250 = 2.5%. Match any negotiated merchant rate.
XENDLY_FEE_BPS=250
# Configure the app webhook URL as https://YOUR_DOMAIN/api/payments/xendly/webhook

# OneSignal Web Push: configure this site's origin with Custom Code Setup.
# These values are server-only; browser configuration is returned only by /api/push/config.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Optional external scheduler: POST /api/penalties/run with Authorization: Bearer CRON_SECRET.
CRON_SECRET=
# Production runs the worker automatically; opt in to background processing during development.
PENALTY_WORKER_ENABLED=false
